#!/usr/bin/env bash
# Generated by agent-instructions install.sh. Edit the template, not this copy.
#
# Runs the status-line command that was configured before installation and
# appends an AGENTS segment. Pre-existing segments are passed through verbatim,
# so this extends the status line rather than replacing it.

input=$(cat)

previous=$(printf '%s' "$input" | { @INNER@ ; })

state=$('@BIN@' status --machine 2>/dev/null)
missing=$('@BIN@' status 2>/dev/null | grep -c '^missing: ')

case "$state" in
  on)       color=$'\033[32m' ;;
  off)      color=$'\033[90m' ;;
  mixed)    color=$'\033[33m' ;;
  conflict) color=$'\033[31m' ;;
  *)        state=conflict; color=$'\033[31m' ;;
esac

segment=" ${color}AGENTS:${state}$(printf '\033[0m')"
# The base state stays readable; the amber count is additional, never a
# replacement.
if [ "$missing" -gt 0 ]; then
  segment="${segment}$(printf '\033[33m')+${missing}!$(printf '\033[0m')"
fi

if [ -n "$previous" ]; then
  printf '%s%s\n' "${previous%$'\n'}" "$segment"
else
  printf '%s\n' "${segment# }"
fi
